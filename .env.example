DATABASE_URL=
LECTURER_USERNAME=
LECTURER_PASSWORD=
LECTURER_SYNC_TOKEN_SECRET=
SYLLO_EXTENSION_ORIGIN=

# Shared-code login; configure the secret in every deployed environment (32+ characters).
SYLLO_ACCESS_CODE=system99
# Separate manager-only code; leave unset locally unless testing the admin login.
SYLLO_ADMIN_ACCESS_CODE=
SYLLO_SESSION_SECRET=

# Lecturer request notifications (set as encrypted environment variables in Vercel Production).
EMAIL_SMTP_HOST=mail.privateemail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=general@syllo.live
EMAIL_SMTP_PASSWORD=
LECTURER_REQUEST_NOTIFICATION_EMAIL=general@syllo.live
