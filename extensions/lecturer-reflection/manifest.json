{
  "manifest_version": 3,
  "name": "Lesson lecturer reflection",
  "version": "0.2.7",
  "description": "Local active-slide timing and pedagogical reflection, enabled by the lecturer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://syllo.live/*",
    "https://stemflow-noamsheffi-gmailcoms-projects.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/courses/communication-systems/lesson-*",
        "https://syllo.live/courses/communication-systems/lesson-*",
        "https://stemflow-noamsheffi-gmailcoms-projects.vercel.app/courses/communication-systems/lesson-*"
      ],
      "js": ["config.js", "auto-start.js", "tracker.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": [
        "http://localhost:3000/courses/communication-systems/lesson-*",
        "https://syllo.live/courses/communication-systems/lesson-*",
        "https://stemflow-noamsheffi-gmailcoms-projects.vercel.app/courses/communication-systems/lesson-*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Start / open lecturer reflection"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "history.html"
}
